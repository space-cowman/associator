{
  "uid": "associator-health",
  "title": "Platform Health",
  "description": "Is the site up, fast and inside its limits? Services (RED), servers (USE), data, backups and free-plan limits.",
  "tags": [
    "associator"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__METRICS_UID__"
        },
        "query": {
          "query": "label_values(target_info, service_name)",
          "refId": "service"
        },
        "definition": "label_values(target_info, service_name)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Services up",
      "description": "Our services that sent telemetry in the last 5 minutes (6 expected: api, web front door, gateway, safety, MCP, orchestrator).",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 5
              },
              {
                "color": "green",
                "value": 6
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "count(count by (service_name) (present_over_time(target_info{service_name!~\"kubelet|postgres-backup\"}[5m])))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests per minute",
      "description": "All requests reaching the site (front door).",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"traefik\"}[5m])) * 60",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "description": "Share of requests failing with a server error (5xx), last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "clamp_max((sum (rate(http_server_request_duration_seconds_count{service_name=\"traefik\", http_response_status_code=~\"5..\"}[5m])) or sum (rate(http_server_request_duration_seconds_count{service_name=\"traefik\"}[5m])) * 0) / (sum (rate(http_server_request_duration_seconds_count{service_name=\"traefik\"}[5m])) > 0), 1)",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Response time (p95)",
      "description": "95 of 100 requests are faster than this.",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"traefik\"}[5m])))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last backup",
      "description": "Hours since the nightly database backup last reached S3 (it runs at 02:00 India time). No data: no backup for 3 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 26
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "(time() - max(last_over_time(associator_backup_last_success_seconds[3d]))) / 3600",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Certificate expires in",
      "description": "Days until the HTTPS certificate for associator.space runs out (Let's Encrypt renews it at 30 days).",
      "datasource": {
        "type": "prometheus",
        "uid": "__METRICS_UID__"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 7
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "__METRICS_UID__"
          },
          "expr": "(min(traefik_tls_certs_not_after_seconds) - time()) / 86400",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "row",
