# Names-only template. Committed. Never put real values here.
#
# Two kinds of settings:
#   1. Secrets      -> stored in AWS Secrets Manager (read by the Makefile read_secret helper)
#   2. Plain config -> not secret; defaults below
#
# Local development only (ENV=local). On AWS, secrets come from Secrets Manager.
# There are no local databases: Postgres/Redis are reached on the AWS nodes
# through an SSM port-forward (Phase 1 step 4).

# --- 1. Secrets (in AWS Secrets Manager, NOT here) ---
# Platform model (Claude Haiku) for Platform AI replies
ANTHROPIC_API_KEY=
# Sign in with Google / GitHub (Phase 1 step 6)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- 2. Plain config ---
ENV=local
AWS_REGION=ap-south-1
PLATFORM_MODEL=claude-haiku-5-5
# Unit tests use the fake model: no calls, no cost
LLM_FAKE=true
# Reached through the SSM tunnel to the AWS nodes (Phase 1 step 4)
DATABASE_URL=postgresql+psycopg://platform_v2_app@127.0.0.1:15432/platform_v2
REDIS_URL=redis://platform_v2_app@127.0.0.1:16379/0
